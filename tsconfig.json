{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*",
    "services/**/*",
    "scripts/**/*.ts",
    "drizzle.d1.config.ts",
    "vitest.config.ts"
  ],
  // exclude はそのまま「CI が見ていない範囲」になる。除外した先は lint 側も
  // コア規則を「tsc が見るから」と無効化しているため、**どちらも見ない死角**になる。
  // 増やす前に必ず「なぜ tsc に見せられないか」を書くこと。
  // 除外は**ディレクトリ単位ではなくファイル単位**にする (ディレクトリ単位だと
  // 後から足したファイルまで自動的に死角へ入る)。
  "exclude": [
    "node_modules",
    "dist"
    // ここは空 (借金残高ゼロ)。**新しい除外を足すときは規模と実行経路を
    // docs/ci-typecheck-blind-spots.md に必ず書くこと**。
  ]
}
