{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*",
    "api/**/*",
    "services/**/*",
    "scripts/**/*.ts",
    "drizzle.*.config.ts",
    "vitest.config.ts"
  ],
  // exclude はそのまま「CI が見ていない範囲」になる。ここに足すのは
  // 型エラーを消す最短手段だが、除外した先は lint 側も
  // typescript-eslint recommended が `no-dupe-keys` 等のコア規則を
  // 「tsc が見るから」と無効化しているため、**どちらも見ない死角**になる。
  // 実際に 002 otakara の未マウント実装では ILIKE (D1 が解釈できない) と
  // shortSummary の重複キー 5 件がこの死角で温存されていた。
  // 増やす前に必ず「なぜ tsc に見せられないか」を書くこと。
  // 除外は**ディレクトリ単位ではなくファイル単位**にする。
  // ディレクトリ単位だと、後から同じ階層に足したファイルまで自動的に
  // 死角へ入る (otakara の未マウント実装がまさにそれで、routes/** 配下に
  // 置くだけで tsc から消えた)。ファイル単位なら、既知の借金だけが除外され、
  // 新規ファイルは必ず typecheck される。
  //
  // 残りは 1 ファイル / 型エラー 1 件。内訳と直し方の当たりは
  // docs/ci-typecheck-blind-spots.md に書いた。**1 ファイル直すたびにここから消す**。
  "exclude": [
    "node_modules",
    "dist",
    ".vercel",
    // services/jss-api/** は除外ではなく所有権の委譲。jss-api は独自 lock・
    // 独自 tsconfig (types: workers-types) を持つ standalone の配信 Worker で、
    // ルート設定 (DOM lib・types: node) では R2Bucket 等が解決できず 4 件の
    // 誤検出が出る。配下の src/test は jss-api 自身の `pnpm typecheck`
    // (CI の python-pipeline ジョブ) が見るので死角にはならない。新規ファイルも
    // jss-api 側の include (src/**/*.ts・test/**/*.ts) に自動で入る。
    // 詳細は docs/ci-typecheck-blind-spots.md の「委譲」節。
    "services/jss-api/**/*"
    // ここは空。UNI レーンが 4 ファイルの型エラーを直し、EMH レーンが
    // verify-price-cache.ts (Neon 期のシグネチャで既に動かなかった) を削除したので、
    // 除外すべき既知の借金はもう無い。**新しい除外を足すときは規模と実行経路を
    // docs/ci-typecheck-blind-spots.md に必ず書くこと**（黙って除外すると、
    // ILIKE と重複キーが 4,245 行の死にコードに紛れて CI を通った件を繰り返す）。
  ]
}
