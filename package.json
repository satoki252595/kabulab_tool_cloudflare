{
  "name": "kabulab",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dev:cf": "wrangler dev",
    "deploy:cf": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src services --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate:d1": "drizzle-kit generate --config=drizzle.d1.config.ts",
    "sync:universe": "tsx scripts/sync/universe.ts",
    "sync:daily": "tsx scripts/sync/all-daily.ts",
    "sync:daily:core": "tsx scripts/sync/daily.ts",
    "sync:monthly": "tsx scripts/sync/all-monthly.ts",
    "sync:monthly:core": "tsx scripts/sync/monthly.ts",
    "ingest:yuho-edinet": "tsx scripts/sync/yuho-edinet.ts",
    "backfill:overseas": "tsx services/yuho-quant/data-scripts/backfill-overseas.ts",
    "audit:overseas": "tsx services/yuho-quant/data-scripts/audit-overseas.ts",
    "ingest:ir-tdnet": "tsx scripts/sync/ir-tdnet.ts",
    "ingest:vwap-daily": "tsx scripts/vwap/ingest-daily.ts",
    "ingest:vwap-intra": "tsx scripts/vwap/ingest-intra.ts",
    "ingest:vwap-margin": "tsx scripts/vwap/ingest-margin.ts",
    "yutai:summary:export": "tsx services/otakara-yutai/data-scripts/export-summary-tasks.ts",
    "yutai:summary:import": "tsx services/otakara-yutai/data-scripts/import-summary-results.ts",
    "yuho:backfill": "tsx services/yuho-quant/data-scripts/backfill.ts",
    "yuho:backfill:text": "tsx services/yuho-quant/data-scripts/backfill-text-sections.ts",
    "yuho:backfill:missing": "tsx services/yuho-quant/data-scripts/backfill-missing-docs.ts",
    "ir:backfill": "tsx services/ir-catalog/data-scripts/backfill.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "kuromoji": "^0.1.2",
    "unpdf": "^1.6.2",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.20.0"
  }
}
