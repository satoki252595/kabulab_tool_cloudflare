DATABASE_URL=postgresql://user:password@host/database?sslmode=require
CRON_SECRET=your-cron-secret-here
# 優待解釈 (interpret:yutai) は完全ローカルの OSS LLM (node-llama-cpp) で実行。
# API キー不要。初回のみ GGUF モデル(数GB)を自動DLしローカルキャッシュする。
# OTAKARA_LLM_MODEL=hf:elyza/Llama-3-ELYZA-JP-8B-GGUF:Q4_K_M  # (任意) 使用モデル上書き
# OTAKARA_LLM_CONCURRENCY=1   # (任意) 並列 sequence 数。単一 Metal で N>1 でも
                              #        線形高速化しないが、KV cache が足りれば
                              #        2-3 で 1.3-1.7x の見込み
# OTAKARA_LLM_BATCH_SIZE=10   # (任意) 1 セッションで解釈する件数。大きくすると
                              #        ELYZA-JP-8B が構造ドリフトしやすい (10 推奨)
# OTAKARA_LLM_GRAMMAR=on      # (任意) "on"=grammar 強制 (JSON 保証だが Llama-3
                              #        の巨大 vocab で CPU bound、1 バッチ ~10 分超)、
                              #        "off"=素生成+Zod+リトライ救済 (実運用設定)

# 005 yuho-quant — EDINET API v2 の Subscription-Key (金融庁 EDINET で発行)
# https://api.edinet-fsa.go.jp/ の利用登録で取得したキー
# D1 移行後(ADR-0001) EDINET 取込は Worker 上で動くため、本番では
# EDINET_API_KEY は Worker secret として設定する (wrangler secret put)。
EDINET_API_KEY=your-edinet-subscription-key-here

# 有報(EDINET)取込トリガ CLI (ingest:yuho-edinet) が叩く Worker の URL。
# D1 はバインディング経由のみのため取込は Worker 側で実行する (ADR-0001)。
WORKER_BASE_URL=https://kabulab-cf.<subdomain>.workers.dev

# VWAP(007) 取込の Yahoo フェッチを Worker 経由にする(ローカルIP の 429 回避・
# ADR-0001)。設定すると ingest:vwap-daily/intra が Worker の認証付きプロキシ
# /vwap-analysis/api/ingest-fetch (CRON_SECRET) 経由で Cloudflare エッジから
# Yahoo を叩く。未設定なら従来通り直叩き。通常は WORKER_BASE_URL と同じ値。
YAHOO_PROXY_BASE=https://kabulab-cf.<subdomain>.workers.dev

# Node 取込から D1 へ書き込むための D1 HTTP API 認証 (ADR-0001)。
# Worker の読取はバインディング(c.env.DB)で完結するので不要。kuromoji/LLM 等
# Node 専用依存を持つ取込(ir-catalog / otakara / sync:daily)が drizzle sqlite-proxy
# 経由で D1 へ書く際に使う。発行: dash → My Profile → API Tokens → Custom Token →
# Account/D1/Edit。
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-with-d1-edit
CLOUDFLARE_ACCOUNT_ID=5880d85c320ca5fee8baf9efddd005ed
D1_DATABASE_ID=639c0315-0d41-4345-95ab-aec5906224ed

# 一次データ Notion アーカイブ (全サービス共通 / CLAUDE.md ルール6)
# Notion Internal Integration トークン。対象 2 ページにインテグレーションを
# 共有しておくこと (Notion ページ右上 … → Connections → 追加)。
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 一次データを記録する「バックアップ」ページ ID (32桁hex, ハイフン有/無可)
NOTION_BACKUP_PAGE_ID=<notion-backup-page-id>
# input 変更等で不要化した元データの退避先「ごみ」ページ ID
NOTION_TRASH_PAGE_ID=<notion-trash-page-id>

# --- VWAP 時系列の R2 書込(ローカル取込用)。CloudflareでR2 APIトークンを発行 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vwap-data

# --- 002 お宝優待: 金額表記なし自社商品の実勢価格を WEB から推定する用途 ---
# 楽天市場 Ichiba Item Search API の Application ID (無料・課金なし)。
# https://webservice.rakuten.co.jp/ でアプリ登録すると発行される。
# enrich-from-web.ts (data-scripts) でのみ使用。未設定なら同スクリプトは起動時に throw。
RAKUTEN_APP_ID=<rakuten-application-id>
