CRON_SECRET=your-cron-secret-here
# 優待の要約 (short_summary / estimated_value) はリポジトリ外のクラウド LLM
# (Cursor Automations 等) が作る。このリポジトリ側で LLM の API キーは使わない
# (services/otakara-yutai/docs/llm-summary-task.md)。

# 005 yuho-quant — EDINET API v2 の Subscription-Key (金融庁 EDINET で発行)
# https://api.edinet-fsa.go.jp/ の利用登録で取得したキー
# D1 移行後(ADR-0001) EDINET 取込は Worker 上で動くため、本番では
# EDINET_API_KEY は Worker secret として設定する (wrangler secret put)。
EDINET_API_KEY=your-edinet-subscription-key-here

# 有報(EDINET)取込トリガ CLI (ingest:yuho-edinet) が叩く Worker の URL。
# D1 はバインディング経由のみのため取込は Worker 側で実行する (ADR-0001)。
WORKER_BASE_URL=https://kabulab-cf.<subdomain>.workers.dev

# 005 yuho-quant — 事業タグ判定 (biztag) が使う TypeSafe jev の API キー。
# https://typesafe.ai/ で発行。秘密情報のため .env / GitHub Secrets のみで管理し、
# コードは src/shared/jev/env.ts の jevEnv.TYPESAFE_API_KEY() 経由でのみ参照する。
TYPESAFE_API_KEY=your-typesafe-api-key-here

# VWAP(007) 取込の Yahoo フェッチを Worker 経由にする(ローカルIP の 429 回避・
# ADR-0001)。設定すると ingest:vwap-daily/intra が Worker の認証付きプロキシ
# /vwap-analysis/api/ingest-fetch (CRON_SECRET) 経由で Cloudflare エッジから
# Yahoo を叩く。未設定なら従来通り直叩き。通常は WORKER_BASE_URL と同じ値。
YAHOO_PROXY_BASE=https://kabulab-cf.<subdomain>.workers.dev

# Node 取込から D1 へ書き込むための D1 HTTP API 認証 (ADR-0001)。
# Worker の読取はバインディング(c.env.DB)で完結するので不要。kuromoji 等
# Node で動かす取込(ir-catalog / otakara / sync:daily)が drizzle sqlite-proxy
# 経由で D1 へ書く際に使う。発行: dash → My Profile → API Tokens → Custom Token →
# Account/D1/Edit。
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-with-d1-edit
CLOUDFLARE_ACCOUNT_ID=5880d85c320ca5fee8baf9efddd005ed
D1_DATABASE_ID=639c0315-0d41-4345-95ab-aec5906224ed

# 一次データ Notion アーカイブ (全サービス共通 / CLAUDE.md ルール6)
# Notion Internal Integration トークン。対象 2 ページにインテグレーションを
# 共有しておくこと (Notion ページ右上 … → Connections → 追加)。
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 一次データ本体・銘柄別データ・ごみ (不要化データの退避先) を置く
# 「一次データ保管」ページ ID (32桁hex, ハイフン有/無可)。2026-09-25 に
# 旧「バックアップ」ページのトラッシュ事件を機に 1 ページへ統合した
# (旧 NOTION_BACKUP_PAGE_ID / NOTION_TRASH_PAGE_ID の役割をここに集約)。
NOTION_ARCHIVE_PAGE_ID=<notion-archive-page-id>
# 索引ページ「アーカイブ索引」の ID (任意。設定時は Search を使わず直接更新)。
# 再配置直後は一旦コメントアウトして再生成させ (`pnpm notion:update-index`)、
# 新しい索引ページ ID を控えてから再設定すること (古い ID のままだと旧
# 「バックアップ」ページ配下の古い索引ページを指してしまう)。
#NOTION_INDEX_PAGE_ID=<notion-index-page-id>
# 有報テキスト (1 行 = 1 通・全銘柄共通の単一 DB) の ID。銘柄コード毎の
# 子ページ/子DBは作らない (2026-09-25 再配置)。
NOTION_YUHO_TEXT_DB_ID=<notion-yuho-text-db-id>
# [移行専用] 上記 DB の「データソース ID」(2025-09-03 以降のマルチソース
# データベースモデルでの ID。database_id とは別値)。
# `pnpm notion:relocate-archive` の POST /pages/{id}/move が使うだけで、
# 移行完了後は不要 (通常の読み書きは NOTION_YUHO_TEXT_DB_ID のみで足りる)。
#NOTION_YUHO_TEXT_DATA_SOURCE_ID=<notion-yuho-text-data-source-id>
# [移行専用・一時] 旧「バックアップ」/「ごみ」ページ ID。
# `pnpm notion:relocate-archive` が旧配置からの移動元を特定するために使う
# だけで、通常の読み書き経路はもう参照しない。移行完了後は削除してよい。
#NOTION_BACKUP_PAGE_ID=<old-notion-backup-page-id>
#NOTION_TRASH_PAGE_ID=<old-notion-trash-page-id>

# 005 yuho-quant — 事業タグ (docs/005-yuho-quant-business-tags.md)。
# 「株式情報」ページ ID (Python パイプラインの ① 銘柄マスタ 等と同じ親)。
NOTION_STOCK_INFO_PAGE_ID=<notion-stock-info-page-id>
# ① 銘柄マスタ DB ID (「銘柄マスタ（補足）」からの relation 先)。下の
# pipeline ブロックにコメントで残る Python 側 NOTION_DB_STOCK_MASTER と同じ値。
NOTION_DB_STOCK_MASTER=<notion-db-stock-master-id>
# 「銘柄マスタ（補足）」DB ID を固定 (任意。未設定でも Search 完全一致で自動発見する)
#NOTION_STOCK_SUPPLEMENT_DB_ID=<notion-stock-supplement-db-id>
# 「事業タグ単語帳（台帳）」DB ID を固定 (任意。未設定でも自動発見する)
#NOTION_BIZTAG_LEDGER_DB_ID=<notion-biztag-ledger-db-id>
# 日次株価 sync (pnpm sync:daily:core) の完了を取引日つきで記録する
# 「株価の日次同期」DB ID を固定 (任意。未設定でも「株式情報」ページ配下を
# Search 完全一致で自動発見・初回実行時に無ければ新規作成する)。
# NOTION_TOKEN / NOTION_STOCK_INFO_PAGE_ID も必要 (上記と共通)。
#NOTION_PRICE_SYNC_DB_ID=<notion-price-sync-db-id>
# 単語帳の年次見直し提案 (Cursor Automation) を受け付ける
# /yuho-quant/vocabulary/* の合言葉ハッシュ (SHA-256 hex)。本番は wrangler.toml
# [vars] で設定する (§11.1 手順5)。ローカルでルートを試す場合のみここに置く。
# 未設定なら Worker は常に 401 を返す (fail-closed)。
#VOCAB_REVIEW_TOKEN_SHA256=<openssl rand -hex 32 のトークンを shasum -a 256 したハッシュ>

# --- VWAP 時系列の R2 書込(ローカル取込用)。CloudflareでR2 APIトークンを発行 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vwap-data

# --- 収集パイプライン (pipeline/) ------------------------------------------------
# NOTION_TOKEN / EDINET_API_KEY は上記の共通定義を使う。
# DB ID はリポジトリ直下の db_ids.json（正本・config.py がリポジトリルート基準で
# 解決する）があれば不要。環境変数を設定すると優先される。
# NOTION_DB_STOCK_MASTER=...
# NOTION_DB_FINANCIALS=...
# NOTION_DB_DISCLOSURES=...
# NOTION_DB_RAW_FILES=...
# 任意: 上書き用。親ページ ID・スロットル・作業ディレクトリ・dry-run。
# 既定値は pipeline/src/jp_stock_pipeline/config.py の DEFAULT_* を参照。
# NOTION_PARENT_PAGE_ID=...
# NOTION_RPS=2.5
# RAW_DATA_DIR=data/raw
# DRY_RUN=false
# NOTION_DB_IDS_FILE=/abs/path/to/db_ids.json  # db_ids.json の在処を変える場合のみ

# --- Cloudflare 正本ストア (pipeline/ の R2/D1 書込) ---------------------------
# 注意: CF_* と CLOUDFLARE_*/D1_DATABASE_ID は同じアカウント・DB を指す別名
# （アカウント ID は R2_ACCOUNT_ID を含めると3系統。Node 側の R2 取込は
# R2_ACCOUNT_ID を読む）。パイプラインのコードは CF_* 側を読む（config.py）。
# 名称統一は別件とし、現状は併存させる（値は一致させること）。
CF_ACCOUNT_ID=
CF_API_TOKEN=            # D1 REST 用（発行: Account/D1/Edit）
CF_D1_DATABASE_ID=
# R2 バケット（既定値あり。変える場合のみ設定）
# R2_BUCKET_TIMESERIES=vwap-data
# R2_BUCKET_RAW=jp-stock-raw
# R2_BUCKET_SUPPLY=jp-stock-supply

# --- 端末B（PostgreSQL）への dual-write（任意） -----------------------------
# 設定すると収集時に Notion と同時にローカル PostgreSQL へミラーする（未設定なら
# Notion のみ）。接続プロファイルは2系統で、収集ジョブの --db-target で選ぶ（既定 cloud）:
#   cloud（既定・クラウド経由）: LOCAL_DB_HOST + LOCAL_DB_SSLMODE。GitHub Actions 等から
#     端末B へ接続。PostgreSQL の直インターネット公開は危険なため、VPN(Tailscale 等)
#     経由を強く推奨（その場合 host は VPN 内アドレス、sslmode=disable でも経路は暗号）。
#   lan（--db-target lan・同一LAN）: LOCAL_DB_LAN_HOST(既定 localhost) + LOCAL_DB_LAN_SSLMODE。
# GitHub Actions では同名の Secrets を設定すると cron 実行で cloud 経路の dual-write が有効化。
LOCAL_DB_HOST=100.x.x.x             # 端末B の到達アドレス（VPN/DDNS 等。cloud 経路）
LOCAL_DB_LAN_HOST=192.168.1.50      # 端末B の LAN 内 IP（lan 経路。既定 localhost）
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=jp_stock
LOCAL_DB_USER=jp_stock
LOCAL_DB_PASSWORD=change-me
# cloud の TLS モード。require は経路を暗号化するがサーバ認証はしない（能動的 MITM
# 対策には VPN 経由 or sslmode=verify-full + ルートCA）。VPN なら経路自体が認証+暗号で disable 可。
LOCAL_DB_SSLMODE=require
# LOCAL_DB_LAN_SSLMODE=prefer       # lan の TLS モード（既定 prefer）

# --- FastAPI（端末B で起動する API サーバ） ----------------------------------
# X-API-Key 認証のキー。未設定だと認証なしで起動する（信頼できる LAN 内のみ推奨）。
LOCAL_API_KEY=change-me-to-a-long-random-string
# 任意: listen するホスト/ポート（既定 0.0.0.0:8000）
# LOCAL_API_HOST=0.0.0.0
# LOCAL_API_PORT=8000
